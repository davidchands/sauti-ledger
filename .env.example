# Neon PostgreSQL connection string. Server-only, never expose to the client.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq API key: Whisper transcription (speech-to-text). Free tier is
# plenty for development: console.groq.com
GROQ_API_KEY=

# Google Gemini API key: transaction extraction (structured data from
# a transcript). Get one at aistudio.google.com
GEMINI_API_KEY=
